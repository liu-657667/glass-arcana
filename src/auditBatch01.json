  "cards": [
    {
      "id": "major-0",
      "system": "RWS",
      "names": {
        "zh-CN": "愚者",
        "en": "The Fool"
      },
      "iconography": {
        "textChecked": {
          "zh-CN": "临崖旅人、犬、玫瑰、肩上行囊、身后太阳。",
          "en": "Traveller at a cliff; dog, rose, shoulder bag and sun behind."
        },
        "imageReview": "pending",
        "pendingChecks": [
          "白玫瑰、白犬和精确方位须对早期图版另验。"
        ]
      },
      "historical": {
        "symbolism": {
          "zh-CN": "第二部侧重寻求经验；第三部另列鲁莽等旧占义，两层不应混作单一标准答案。",
          "en": "Part II concerns seeking experience; Part III separately gives older adverse divination."
        },
        "divination": {
          "zh-CN": "正位：鲁莽等；逆位：疏忽等。摘要而非完整译本。",
          "en": "Upright: folly, among other terms. Reversed: negligence, among other terms. Selective summary."
        },
        "locator": "Part II §2, Zero; Part III §3, Zero",
        "isCompleteTranslation": false
      },
      "modern": {
        "kind": "original_reflection_not_prediction",
        "theme": {
          "zh-CN": "启程与准备",
          "en": "Beginning and preparation"
        },
        "uprightPrompt": {
          "zh-CN": "我愿意尝试什么？迈出小步前，还需要核实哪一项风险？",
          "en": "What would I like to try, and which risk should I check before taking a small step?"
        },
        "reversedPrompt": {
          "zh-CN": "我是在谨慎准备，还是不断推迟？怎样分清两者？",
          "en": "Am I preparing carefully or postponing? How can I tell the difference?"
        },
        "reversalNote": {
          "zh-CN": "逆位是另一种反思角度，不是坏运气，也不等于原典逆位释义。",
          "en": "Reversal is another reflective angle, not bad luck or a reproduction of historical reversed meanings."
        }
      },
      "review": {
        "primaryText": "checked",
        "historicalSummary": "checked_selective",
        "bilingual": "draft_reviewed",
        "earlyPlateVisual": "pending",
        "artwork": "not_reviewed",
        "overall": "partially_audited"
      },
      "sources": [
