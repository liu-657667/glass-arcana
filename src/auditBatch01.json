      ]
    },
    {
      "id": "major-2",
      "system": "RWS",
      "names": {
        "zh-CN": "女祭司",
        "en": "The High Priestess"
      },
      "iconography": {
        "textChecked": {
          "zh-CN": "月牙在脚边；角状冠中央有球；胸前十字；半遮的 Tora 卷轴；B/J 黑白柱；棕榈与石榴帷幕。",
          "en": "Crescent at feet; horned crown and globe; cross; partly covered Tora scroll; black/white B/J pillars; palm-and-pomegranate veil."
        },
        "imageReview": "pending",
        "pendingChecks": [
          "左右柱位需图版核验，文本列举顺序不能证明画面左右。"
        ]
      },
      "historical": {
        "symbolism": {
          "zh-CN": "韦特把半遮卷轴联系到显明与隐含的教义，背景属于其宗教神秘主义。",
          "en": "Waite links the covered scroll with explicit and implicit teaching in his religious mysticism."
        },
        "divination": {
          "zh-CN": "正位：秘密、尚未显露；逆位：表面知识等。原文含性别化指代，应用不沿用。",
          "en": "Upright: mystery, unrevealed matters. Reversed: surface knowledge, among others. Gendered identifications are not used here."
        },
        "locator": "Part II §2, II; Part III §3, 2",
        "isCompleteTranslation": false
      },
      "modern": {
        "kind": "original_reflection_not_prediction",
        "theme": {
          "zh-CN": "静观与求证",
          "en": "Observation and verification"
        },
        "uprightPrompt": {
          "zh-CN": "哪些是已知事实，哪些只是我的直觉？还缺什么信息？",
          "en": "What is established fact, what is intuition, and what information is missing?"
        },
        "reversedPrompt": {
          "zh-CN": "我是否把猜测当成确定的知识？可以向哪里求证？",
          "en": "Am I treating an assumption as knowledge? Where could I check it?"
        },
        "reversalNote": {
          "zh-CN": "逆位是另一种反思角度，不是坏运气，也不等于原典逆位释义。",
          "en": "Reversal is another reflective angle, not bad luck or a reproduction of historical reversed meanings."
        }
      },
      "review": {
        "primaryText": "checked",
        "historicalSummary": "checked_selective",
        "bilingual": "draft_reviewed",
        "earlyPlateVisual": "pending",
        "artwork": "not_reviewed",
