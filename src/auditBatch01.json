    {
      "id": "cups-8",
      "system": "RWS",
      "names": {
        "zh-CN": "圣杯八",
        "en": "Eight of Cups"
      },
      "iconography": {
        "textChecked": {
          "zh-CN": "旅人离开原先的杯子。",
          "en": "A traveller leaves the cups behind."
        },
        "imageReview": "pending",
        "pendingChecks": [
          "八杯、下五上三、缺口、月与山水待逐图视觉复核；许可页已查。"
        ]
      },
      "historical": {
        "symbolism": {
          "zh-CN": "原书明确记录相反释义；离开不是唯一原典解释。",
          "en": "Waite explicitly records conflicting readings; departure is not the sole historical interpretation."
        },
        "divination": {
          "zh-CN": "正位有事情衰退，也有相反的喜悦等解读；逆位记喜悦与宴饮。",
          "en": "Upright includes decline and contradictory joyful readings; reversed includes joy and feasting."
        },
        "locator": "Part III §2, Cups Eight",
        "isCompleteTranslation": false
      },
      "modern": {
        "kind": "original_reflection_not_prediction",
        "theme": {
          "zh-CN": "重新评估投入",
          "en": "Reassessing commitment"
        },
        "uprightPrompt": {
          "zh-CN": "我继续投入是出于重视，还是只因已经付出了很多？",
          "en": "Am I continuing because this matters, or simply because I have already invested a lot?"
        },
        "reversedPrompt": {
          "zh-CN": "留下、离开或暂缓各有什么现实代价？先核实什么？",
          "en": "What are the practical costs of staying, leaving or pausing? What should I verify first?"
        },
        "reversalNote": {
          "zh-CN": "逆位是另一种反思角度，不是坏运气，也不等于原典逆位释义。",
          "en": "Reversal is another reflective angle, not bad luck or a reproduction of historical reversed meanings."
        }
      },
