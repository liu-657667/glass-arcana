    {
      "id": "major-13",
      "system": "RWS",
      "names": {
        "zh-CN": "死神",
        "en": "Death"
      },
      "iconography": {
        "textChecked": {
          "zh-CN": "骑者持黑旗与玫瑰；没有可见武器；远处双柱之间有太阳。",
          "en": "Rider, black rose-banner, no visible weapon; sun between distant pillars."
        },
        "imageReview": "pending",
        "pendingChecks": [
          "白马、盔甲、玫瑰五瓣和人物姿态须图版复核；禁加镰刀。"
        ]
      },
      "historical": {
        "symbolism": {
          "zh-CN": "第二部既讨论转变，也涉及死亡与精神过渡；不可伪称原典只谈新开始。",
          "en": "Part II treats transformation as well as death and spiritual passage, not only fresh starts."
        },
        "divination": {
          "zh-CN": "正位含结束、死亡等旧词；逆位含停滞。仅作历史说明，不据此预测健康或死亡。",
          "en": "Upright includes endings and mortality; reversed includes inertia. Historical context, not a health or death prediction."
        },
        "locator": "Part II §2, XIII; Part III §3, 13",
        "isCompleteTranslation": false
      },
      "modern": {
        "kind": "original_reflection_not_prediction",
        "theme": {
          "zh-CN": "结束与调整",
          "en": "Endings and adjustment"
        },
        "uprightPrompt": {
          "zh-CN": "什么已经不再适合我？我能以什么稳妥方式结束或调整它？",
          "en": "What no longer fits, and how could I end or adjust it safely?"
        },
        "reversedPrompt": {
          "zh-CN": "面对变化，我需要时间、支持，还是一个更小的行动？",
          "en": "Facing change, do I need time, support, or a smaller action?"
        },
        "reversalNote": {
          "zh-CN": "逆位是另一种反思角度，不是坏运气，也不等于原典逆位释义。",
          "en": "Reversal is another reflective angle, not bad luck or a reproduction of historical reversed meanings."
        }
      },
