{
  "name": "glass-arcana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/verify-third-party-notices.mjs",
    "test": "npm run test:unit && node --test server/*.test.mjs",
    "reflection:mock": "node server/reflection.mjs",
    "test:reflection": "node --test server/reflection.test.mjs",
    "test:openai:offline": "node --test server/openaiProvider.test.mjs",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "build:web": "python3 scripts/prepare-web-assets.py && vue-tsc --noEmit && vite build --mode web-lite && node scripts/verify-third-party-notices.mjs dist-web && node scripts/verify-web-assets.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
